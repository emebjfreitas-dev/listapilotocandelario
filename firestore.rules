rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net — Default-deny all unexpected paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Security Primitives & Institutional Verification
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isInstitutionalUser() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email.matches('.*@(educacao\\.)?jundiai\\.sp\\.gov\\.br$') ||
          request.auth.token.email.matches('.*@jundiai\\.sp\\.gov\\.br$')
        );
    }

    function isAdmin() {
      return isInstitutionalUser() && (
        request.auth.token.email == 'emebjfreitas@jundiai.sp.gov.br' ||
        request.auth.token.email == 'emebjfreitas@educacao.jundiai.sp.gov.br' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isClassTeacher(data) {
      return isInstitutionalUser() && (
        (('teacherEmail' in data) &&
          data.teacherEmail is string &&
          data.teacherEmail.size() <= 160 &&
          data.teacherEmail.lower() == request.auth.token.email.lower()) ||
        (('authorizedTeacherEmails' in data) &&
          data.authorizedTeacherEmails is list &&
          data.authorizedTeacherEmails.size() <= 10 &&
          request.auth.token.email.lower() in data.authorizedTeacherEmails)
      );
    }

    function isValidClass(data) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() <= 100 &&
        data.shift is string &&
        data.shift.size() <= 50 &&
        data.students is list &&
        data.students.size() <= 60 &&
        (!('teacherEmail' in data) || (data.teacherEmail is string && data.teacherEmail.size() <= 160)) &&
        (!('authorizedTeacherEmails' in data) || (data.authorizedTeacherEmails is list && data.authorizedTeacherEmails.size() <= 10));
    }

    function isValidStateMeta(data) {
      return data.updatedAtMs is number &&
        data.keys().hasOnly([
          'updatedAtMs',
          'classesUpdatedAtMs',
          'configUpdatedAtMs',
          'lastChangedClassIds',
          'epochUpdatedAtMs',
          'epochVersion',
          'updatedAtISO',
          'cleanResetEpochId'
        ]) &&
        (!('configUpdatedAtMs' in data) || data.configUpdatedAtMs is number) &&
        (!('lastChangedClassIds' in data) || (data.lastChangedClassIds is list && data.lastChangedClassIds.size() <= 40));
    }

    function isValidConfigMeta(data) {
      return data.updatedAtMs is number &&
        data.keys().hasOnly([
          'updatedAtMs',
          'authorizedUsers',
          'accessSessionLogs',
          'attendanceWindowConfig',
          'schoolNotices',
          'cloudLinks',
          'discoveredNominalPdfs',
          'discoveredDrivePhotos',
          'genderDictionary',
          'lgpdConfig',
          'cleanResetEpochId'
        ]);
    }

    function isTeacherAllowedConfigUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'updatedAtMs',
        'discoveredNominalPdfs',
        'discoveredDrivePhotos',
        'genderDictionary'
      ]);
    }

    function isValidFcmToken(data) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.userEmail is string &&
        data.userEmail.size() >= 5 &&
        data.userEmail.size() <= 160 &&
        data.channel in ['fcm_push', 'sw_realtime'] &&
        data.active is bool &&
        data.updatedAtMs is number &&
        (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512));
    }

    function isValidFcmAlert(data) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.title is string &&
        data.title.size() <= 180 &&
        data.body is string &&
        data.body.size() <= 600 &&
        data.category in ['prazo', 'aviso', 'busca_ativa'] &&
        data.urgency in ['info', 'warning', 'urgent'] &&
        data.createdAtMs is number &&
        data.createdByEmail is string &&
        data.createdByEmail.size() <= 160;
    }

    function isValidDriveFileSyncMeta(data) {
      return data.keys().hasAll([
          'id', 'kind', 'driveFileId', 'byteSize', 'sha256',
          'md5Checksum', 'syncVersion', 'updatedAtMs', 'updatedByEmail'
        ]) &&
        data.keys().hasOnly([
          'id', 'studentId', 'classId', 'kind', 'fileName',
          'driveFileId', 'driveWebViewLink', 'driveFolderId',
          'mimeType', 'byteSize', 'sha256', 'md5Checksum',
          'syncVersion', 'appDataBackedUp', 'updatedAtMs', 'updatedByEmail'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.kind in ['photo', 'pdf', 'metadata_backup'] &&
        data.driveFileId is string && data.driveFileId.size() >= 1 && data.driveFileId.size() <= 160 &&
        data.byteSize is number && data.byteSize >= 0 &&
        data.sha256 is string && data.sha256.size() >= 16 && data.sha256.size() <= 128 &&
        data.md5Checksum is string && data.md5Checksum.size() >= 16 && data.md5Checksum.size() <= 64 &&
        data.syncVersion is number && data.syncVersion >= 1 &&
        data.updatedAtMs is number &&
        data.updatedByEmail is string && data.updatedByEmail.size() <= 160 &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128)) &&
        (!('classId' in data) || (data.classId is string && data.classId.size() <= 128)) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 240)) &&
        (!('driveWebViewLink' in data) || (data.driveWebViewLink is string && data.driveWebViewLink.size() <= 512)) &&
        (!('driveFolderId' in data) || (data.driveFolderId is string && data.driveFolderId.size() <= 160)) &&
        (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 120)) &&
        (!('appDataBackedUp' in data) || data.appDataBackedUp is bool);
    }

    // Classes collection (1 document per class, max 60 students per class, <1MB each)
    // Only Admins may create/delete classes; assigned PEB I teachers may only update their own class(es) without wiping rosters.
    match /school_classes_2027/{classId} {
      allow get: if isInstitutionalUser() && isValidId(classId);
      allow list: if isInstitutionalUser();
      allow create: if isAdmin() &&
        isValidId(classId) &&
        incoming().id == classId &&
        isValidClass(incoming());
      allow update: if isValidId(classId) &&
        isValidClass(incoming()) &&
        incoming().id == existing().id && (
          isAdmin() || (
            isClassTeacher(existing()) &&
            incoming().get('teacherEmail', '') == existing().get('teacherEmail', '') &&
            incoming().get('authorizedTeacherEmails', []) == existing().get('authorizedTeacherEmails', []) &&
            (existing().students.size() == 0 || incoming().students.size() > 0)
          )
        );
      allow delete: if isAdmin() && isValidId(classId);
    }

    // School metadata & configuration (state watermark + tiered config updates)
    match /school_meta_2027/{docId} {
      allow get: if isInstitutionalUser() && isValidId(docId);
      allow list: if isInstitutionalUser();
      allow create: if isValidId(docId) && (
        (docId == 'state' && isInstitutionalUser() && isValidStateMeta(incoming())) ||
        (docId == 'config' && isAdmin() && isValidConfigMeta(incoming()))
      );
      allow update: if isValidId(docId) && (
        (docId == 'state' && isInstitutionalUser() && isValidStateMeta(incoming())) ||
        (docId == 'config' && isValidConfigMeta(incoming()) && (isAdmin() || (isInstitutionalUser() && isTeacherAllowedConfigUpdate())))
      );
      allow delete: if isAdmin() && isValidId(docId);
    }

    // FCM Push Device Tokens (PII-isolated: teachers only read/manage their own token; admins inspect coverage)
    match /school_fcm_tokens_2027/{subscriptionId} {
      allow get: if isValidId(subscriptionId) && (isAdmin() || (
        isInstitutionalUser() &&
        resource.data.userEmail == request.auth.token.email
      ));
      allow list: if isAdmin() || (
        isInstitutionalUser() &&
        resource.data.userEmail == request.auth.token.email
      );
      allow create, update: if isInstitutionalUser() &&
        isValidId(subscriptionId) &&
        incoming().id == subscriptionId &&
        isValidFcmToken(incoming()) &&
        (isAdmin() || incoming().userEmail == request.auth.token.email);
      allow delete: if isAdmin() || (
        isInstitutionalUser() &&
        isValidId(subscriptionId) &&
        existing().userEmail == request.auth.token.email
      );
    }

    // FCM Attendance Closing Alerts broadcast feed
    match /school_fcm_alerts_2027/{alertId} {
      allow get: if isInstitutionalUser() && isValidId(alertId);
      allow list: if isInstitutionalUser();
      allow create, update: if isAdmin() &&
        isValidId(alertId) &&
        incoming().id == alertId &&
        isValidFcmAlert(incoming());
      allow delete: if isAdmin() && isValidId(alertId);
    }

    // Verified Lossless Google Drive File Sync Manifests (cross-device integrity ledger)
    match /school_drive_sync_2027/{fileKey} {
      allow get: if isInstitutionalUser() && isValidId(fileKey);
      allow list: if isInstitutionalUser();
      allow create, update: if isInstitutionalUser() &&
        isValidId(fileKey) &&
        incoming().id == fileKey &&
        isValidDriveFileSyncMeta(incoming()) &&
        (isAdmin() || incoming().updatedByEmail.lower() == request.auth.token.email.lower());
      allow delete: if isAdmin() && isValidId(fileKey);
    }
  }
}
