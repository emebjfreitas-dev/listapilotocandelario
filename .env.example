# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# EMEB_DATA_DIR: Optional server directory for persistent runtime artifacts.
# EMEB_DATA_DIR="./.emeb_data"

# VITE_DRIVE_LOSSLESS_CHUNK_BYTES: Optional resumable upload chunk size (multiple of 256 KiB, default 1048576).
# VITE_DRIVE_LOSSLESS_CHUNK_BYTES="1048576"

# VITE_DRIVE_MAX_CONCURRENCY: Optional concurrent upload/download worker pool limit (default 3).
# VITE_DRIVE_MAX_CONCURRENCY="3"

# Variáveis opcionais para Firebase Cloud Messaging (FCM HTTP v1) em hospedagem própria:
# (Não obrigatórias no AI Studio — o servidor já gera chaves Web Push VAPID automaticamente)
# VITE_FIREBASE_VAPID_KEY=""
# FIREBASE_SERVICE_ACCOUNT_JSON=""

