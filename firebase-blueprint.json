{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Official student enrollment and attendance record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "ra": { "type": "string", "maxLength": 30 },
        "digRa": { "type": "string", "maxLength": 10 },
        "number": { "type": "number" },
        "situation": { "type": "string", "maxLength": 50 },
        "totalAbsencesMonth": { "type": "number" },
        "justifiedAbsences": { "type": "number" },
        "diasLetivosRecorte": { "type": "number" },
        "photoSha256": { "type": "string", "maxLength": 128 },
        "photoMd5": { "type": "string", "maxLength": 64 },
        "photoSyncVersion": { "type": "number" },
        "fichaPdfSha256": { "type": "string", "maxLength": 128 },
        "fichaPdfMd5": { "type": "string", "maxLength": 64 },
        "fichaPdfSyncVersion": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "ClassGroup": {
      "title": "ClassGroup",
      "description": "Class group entity containing students, teacher ownership, and class metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "grade": { "type": "string", "maxLength": 100 },
        "shift": { "type": "string", "maxLength": 50 },
        "room": { "type": "string", "maxLength": 50 },
        "teacherEmail": { "type": "string", "maxLength": 160 },
        "authorizedTeacherEmails": { "type": "array" },
        "totalStudents": { "type": "number" },
        "classesHeld": { "type": "number" },
        "classesPlanned": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "version": { "type": "number" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "name", "shift"]
    },
    "SchoolMeta": {
      "title": "SchoolMeta",
      "description": "Central metadata configuration, authorization lists, notices, and epoch state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "updatedAtMs": { "type": "number" },
        "classesUpdatedAtMs": { "type": "number" },
        "epochUpdatedAtMs": { "type": "number" },
        "epochVersion": { "type": "number" },
        "updatedAtISO": { "type": "string", "maxLength": 40 },
        "cleanResetEpochId": { "type": "string", "maxLength": 128 },
        "version": { "type": "number" },
        "authorizedUsers": { "type": "array" },
        "accessSessionLogs": { "type": "array" },
        "attendanceWindowConfig": { "type": "object" },
        "schoolNotices": { "type": "array" },
        "cloudLinks": { "type": "object" },
        "discoveredNominalPdfs": { "type": "array" },
        "discoveredDrivePhotos": { "type": "array" },
        "genderDictionary": { "type": "array" },
        "lgpdConfig": { "type": "object" }
      },
      "required": ["updatedAtMs"]
    },
    "FcmDeviceToken": {
      "title": "FcmDeviceToken",
      "description": "FCM Web Push device subscription metadata per institutional teacher/staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "userName": { "type": "string", "maxLength": 160 },
        "userRole": { "type": "string", "maxLength": 30 },
        "teacherRoleType": { "type": "string", "maxLength": 30 },
        "assignedClassIds": { "type": "array" },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "vapidSource": { "type": "string", "maxLength": 30 },
        "channel": { "type": "string", "maxLength": 30 },
        "permission": { "type": "string", "maxLength": 30 },
        "deviceLabel": { "type": "string", "maxLength": 80 },
        "active": { "type": "boolean" },
        "createdAtISO": { "type": "string", "maxLength": 40 },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["id", "userEmail", "channel", "active", "updatedAtMs"]
    },
    "FcmWindowAlert": {
      "title": "FcmWindowAlert",
      "description": "Attendance launch window closing push alert broadcast",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 180 },
        "body": { "type": "string", "maxLength": 600 },
        "category": { "type": "string", "maxLength": 30 },
        "urgency": { "type": "string", "maxLength": 20 },
        "targetScreen": { "type": "string", "maxLength": 50 },
        "targetClassIds": { "type": "array" },
        "targetAudience": { "type": "string", "maxLength": 30 },
        "closingDateFormatted": { "type": "string", "maxLength": 30 },
        "windowPhase": { "type": "string", "maxLength": 40 },
        "createdAtMs": { "type": "number" },
        "createdAtISO": { "type": "string", "maxLength": 40 },
        "createdByEmail": { "type": "string", "maxLength": 160 },
        "createdByName": { "type": "string", "maxLength": 160 },
        "pendingClassesCount": { "type": "number" }
      },
      "required": ["id", "title", "body", "category", "urgency", "createdAtMs", "createdByEmail"]
    },
    "DriveFileSyncMeta": {
      "title": "DriveFileSyncMeta",
      "description": "Lossless Google Drive file sync manifest with SHA-256 and MD5 checksums for cross-device consistency",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "kind": { "type": "string", "enum": ["photo", "pdf", "metadata_backup"] },
        "fileName": { "type": "string", "maxLength": 240 },
        "driveFileId": { "type": "string", "maxLength": 160 },
        "driveWebViewLink": { "type": "string", "maxLength": 512 },
        "driveFolderId": { "type": "string", "maxLength": 160 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "byteSize": { "type": "number" },
        "sha256": { "type": "string", "maxLength": 128 },
        "md5Checksum": { "type": "string", "maxLength": 64 },
        "syncVersion": { "type": "number" },
        "appDataBackedUp": { "type": "boolean" },
        "updatedAtMs": { "type": "number" },
        "updatedByEmail": { "type": "string", "maxLength": 160 }
      },
      "required": ["id", "kind", "driveFileId", "byteSize", "sha256", "md5Checksum", "syncVersion", "updatedAtMs", "updatedByEmail"]
    }
  },
  "firestore": {
    "/school_classes_2027/{classId}": {
      "schema": "ClassGroup",
      "description": "Classes collection partitioned by class identifier (40 classes, <1MB each)"
    },
    "/school_meta_2027/{docId}": {
      "schema": "SchoolMeta",
      "description": "School operational metadata, calendar config, users, and audit state"
    },
    "/school_fcm_tokens_2027/{subscriptionId}": {
      "schema": "FcmDeviceToken",
      "description": "Registered FCM Web Push tokens and notification channel state per user device"
    },
    "/school_fcm_alerts_2027/{alertId}": {
      "schema": "FcmWindowAlert",
      "description": "Attendance closing window FCM push alerts dispatched to teachers"
    },
    "/school_drive_sync_2027/{fileKey}": {
      "schema": "DriveFileSyncMeta",
      "description": "Verified SHA-256/MD5 Drive file sync manifests shared across institutional users"
    }
  }
}
